{
  "name": "razekit-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RazeKit backend API \u2014 the off-Base44 replacement (Node + TypeScript + Express + Prisma/PostgreSQL).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "seed:money": "tsx scripts/seed-money-rules.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "clean:demo": "tsx scripts/seed-demo.ts --clean",
    "import:data": "tsx scripts/import-data.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "seed:sim": "tsx scripts/seed-simulation.ts",
    "clean:sim": "tsx scripts/seed-simulation.ts --clean",
    "verify:payments": "tsx scripts/verify-beta-payments.ts",
    "verify:admin": "tsx scripts/verify-admin.ts",
    "verify:split-db": "tsx scripts/verify-split-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "nodemailer": "^6.9.16",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
