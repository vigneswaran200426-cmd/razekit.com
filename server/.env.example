# ─────────────────────────────────────────────────────────────────────────────
# RazeKit backend environment. Copy to `.env` and fill in.
# NEVER commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of THIS backend (used to build webhook + payment redirect URLs)
API_BASE_URL=http://localhost:4000
# Public URL of the frontend (CORS + auth redirects)
WEB_BASE_URL=http://localhost:5173
# Comma-separated allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local Docker:   postgresql://razekit:razekit@localhost:5432/razekit?schema=public
# Neon/Supabase:  paste the connection string they give you (keep ?sslmode=require)
# ── Databases ────────────────────────────────────────────────────────────────
# PLATFORM: users, contests, submissions, winners, the ledger, funding, payouts
# and the audit trail. This is RazeKit.
DATABASE_URL=postgresql://razekit:razekit@localhost:5432/razekit?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# First admin bootstrap (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@razekit.com
ADMIN_PASSWORD=change-me-strong

# ── Google OAuth (optional until you register an app) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/oauth/google/callback

# ── Object storage ───────────────────────────────────────────────────────────
# STORAGE_DRIVER=local   → files saved under ./_storage and served by this API (dev only)
# STORAGE_DRIVER=s3      → any S3-compatible store (AWS S3, Cloudflare R2, MinIO, Supabase Storage)
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/files
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=razekit-public
S3_BUCKET_PRIVATE=razekit-private
S3_FORCE_PATH_STYLE=true

# ── Email ────────────────────────────────────────────────────────────────────
# EMAIL_DRIVER=console  → prints emails to the server log (dev, no account needed)
# EMAIL_DRIVER=resend   → set RESEND_API_KEY
# EMAIL_DRIVER=smtp     → set SMTP_* (works with SES, Postmark, Mailgun, Gmail app pw)
EMAIL_DRIVER=console
EMAIL_FROM="RazeKit <support@razekit.com>"
SUPPORT_EMAIL=support@razekit.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── LLM (help assistant, moderation triage, quality) ─────────────────────────
# LLM_DRIVER=stub      → deterministic canned responses (no key, dev)
# LLM_DRIVER=anthropic → set ANTHROPIC_API_KEY
LLM_DRIVER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# ── Image generation (contest artwork) ───────────────────────────────────────
# IMAGE_DRIVER=stub    → returns a deterministic placeholder image URL (no key, dev)
# IMAGE_DRIVER=openai  → set OPENAI_API_KEY (uses the Images API)
IMAGE_DRIVER=stub
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
# 1024x1024 | 1024x1536 | 1536x1024 | auto — anything else is a 400 from the API.
IMAGE_SIZE=1536x1024

# ── Payments ─────────────────────────────────────────────────────────────────
# No payment gateway is integrated. Prize funding and winner payouts are handled
# off-platform. The wallet / escrow / fees / payout DOMAIN remains in the code.

# ── Scheduler ────────────────────────────────────────────────────────────────
# Set to false to disable in-process cron (e.g. when running a separate worker)
ENABLE_SCHEDULER=true

# ── Beta manual payment + ledger (SERVER-ONLY) ───────────────────────────────
# RazeKit is in BETA: prize funding is a manual bank transfer verified by a
# human. No payment gateway is connected and no transfer is ever auto-confirmed.
#
#   MANUAL_BETA  — manual bank transfer + admin verification (current)
#   GATEWAY      — automated provider (see UroPay below)
#   MAINTENANCE  — funding paused, existing records read-only
PAYMENT_MODE=MANUAL_BETA
# Names a specific adapter and wins over PAYMENT_MODE when set: manual_beta | uropay
# PAYMENT_GATEWAY=uropay

# ── UroPay (India UPI collection) ────────────────────────────────────────────
# UroPay COLLECTS UPI payments. It does NOT do refunds and does NOT do payouts —
# its API has no endpoint for either — so refunds stay admin-reviewed and creator
# payouts stay on the manual beta process. It is UPI only; there is no card rail.
#
# test | production. These read DIFFERENT variables and never fall back to each
# other: selecting production without production credentials fails closed rather
# than quietly using the test key against real money.
UROPAY_ENV=test
UROPAY_TEST_KEY=
UROPAY_TEST_SECRET=
UROPAY_PRODUCTION_KEY=
UROPAY_PRODUCTION_SECRET=
# Production needs credentials AND this flag. Leave false until UroPay merchant
# production access is actually granted.
UROPAY_PRODUCTION_ENABLED=false
# Optional: the UPI address money is collected into, if not the account default.
UROPAY_VPA=
UROPAY_VPA_NAME=
# Optional provider sandbox host. Must be https; anything else is ignored and the
# pinned https://api.uropay.me is used instead.
# UROPAY_BASE_URL=

# ── Poll campaigns ───────────────────────────────────────────────────────────
# Salt for deriving an anonymous voter key. Changing it resets anonymous vote
# identity (people could vote again), so set it once and keep it.
POLL_VOTE_SALT=change-me-to-a-long-random-string

# Destination account shown ONLY to an authenticated, authorised brand through
# GET beta funding instructions. NEVER put these in the frontend, a public API
# response, VITE_* vars, or git. The account number is masked everywhere except
# the funding-instructions response for the owning brand.
BETA_BANK_ACCOUNT_NAME=
BETA_BANK_NAME=
BETA_BANK_BRANCH=
BETA_BANK_ACCOUNT_NUMBER=
BETA_BANK_IFSC=
BETA_BANK_UPI_ID=

# Support contact printed on funding instructions and payment emails.
BETA_SUPPORT_PHONE=
BETA_SUPPORT_EMAIL=

# Stated (not guaranteed) manual verification window, in hours.
BETA_FUNDING_VERIFICATION_HOURS=24

# ADMIN (optional second Neon project): TrustReport, EnforcementAction and
# AdminPermission only. The admin console reads BOTH databases — platform data
# to administer, admin data to record what staff did about it.
#
# Leave empty to run everything in one database; nothing else changes.
#
# Deliberately NOT here: AuditLog and the ledger. Finance writes audit rows
# inside the same transaction as the ledger postings they describe, and two
# databases cannot share a transaction — an audit row that can survive a
# rollback is worse than none.
ADMIN_DATABASE_URL=

# ── Social platform integrations (Tracker) ───────────────────────────────────
# Every platform is independently optional. An adapter with no credentials
# reports itself inert and the product says "not available" rather than showing
# an empty dashboard that reads as zero engagement.
#
# Encrypts OAuth tokens at rest (AES-256-GCM). Without it the token store
# REFUSES to write rather than keeping a creator's access token in plaintext,
# so social connections simply will not work until this is set.
SOCIAL_TOKEN_KEY=

# Instagram + Threads: Meta app, and both need App Review + Business
# Verification before creators outside your own app can connect.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# TikTok: Login Kit + Display API. Scopes user.info.basic, video.list.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube: enable BOTH Data API v3 and Analytics API v2 in Google Cloud.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# X: reads are metered and billed per request — mind the sync cadence.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Reddit: the User-Agent is mandatory and enforced; a default one gets
# throttled regardless of a valid token. Commercial use needs a separate
# agreement with Reddit (Data API Terms 3.1).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:com.razekit.tracker:v1.0 (by /u/your-reddit-username)

# ---------------------------------------------------------------------------
# Development area (RazeKit DEV engine)
# ---------------------------------------------------------------------------
# The autonomous app/website/game build area. ENTIRELY OPTIONAL: leave
# DEV_ENGINE_URL empty and the area reports itself unconfigured, hides itself
# from the navigation, and nothing else in RazeKit changes.

# Where the RazeKit DEV engine is reachable. Server-to-server only; the browser
# never calls it.
DEV_ENGINE_URL=

# SECRET. Must match RAZEKIT_PRINCIPAL_SECRET on the engine. This is what lets
# RazeKit vouch for a signed-in account, so the engine needs no user table of
# its own and nobody signs in twice. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEV_PRINCIPAL_SECRET=

# How long a minted principal stays valid. It is minted per request, so it
# never needs to outlive one; keep it short.
DEV_PRINCIPAL_TTL_MS=120000
DEV_ENGINE_TIMEOUT_MS=30000

# Only used by `npm run verify:development` to find a razekit-dev checkout.
# Defaults to ../razekit-dev beside this repository.
# DEV_ENGINE_PATH=
