{
  "name": "DownloadLog",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string",
      "title": "Submission ID"
    },
    "contest_id": {
      "type": "string",
      "title": "Contest ID"
    },
    "user_id": {
      "type": "string",
      "title": "User ID (downloader)"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "denied",
        "expired"
      ],
      "default": "success",
      "title": "Download Status"
    },
    "downloaded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Downloaded At"
    }
  },
  "required": [
    "submission_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}