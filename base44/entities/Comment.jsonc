{
  "name": "Comment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "title": "Post ID"
    },
    "author_id": {
      "type": "string",
      "title": "Author ID",
      "description": "Display-only denormalized author id. NEVER used for authorization \u2014 ownership is enforced via the platform-trusted created_by_id."
    },
    "author_name": {
      "type": "string",
      "title": "Author Name (display only)"
    },
    "author_username": {
      "type": "string",
      "title": "Author Username (display only)"
    },
    "text": {
      "type": "string",
      "title": "Comment Text"
    },
    "parent_id": {
      "type": "string",
      "title": "Parent Comment ID"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "title": "Likes"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "visible",
        "removed",
        "pending_review"
      ],
      "default": "visible",
      "title": "Moderation Status"
    }
  },
  "required": [
    "post_id",
    "author_id",
    "text"
  ],
  "rls": {
    "read": {},
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}