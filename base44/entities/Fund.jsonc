{
  "name": "Fund",
  "type": "object",
  "description": "Legacy ledger. Non-client-writable during financial consolidation \u2014 PaymentTransaction is the authoritative ledger. Existing data is preserved.",
  "properties": {
    "amount": {
      "type": "number",
      "description": "Transaction amount (positive for added, negative for reserved)"
    },
    "type": {
      "type": "string",
      "enum": [
        "added",
        "reserved",
        "released"
      ],
      "default": "added",
      "description": "Transaction type"
    },
    "description": {
      "type": "string",
      "description": "Transaction description"
    },
    "contest_id": {
      "type": "string",
      "description": "Related contest ID if applicable"
    }
  },
  "required": [
    "amount",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}