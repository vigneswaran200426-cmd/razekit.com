{
  "name": "PaymentQuote",
  "type": "object",
  "description": "Immutable server-computed price quote for contest prize funding. Created by the payment quote endpoint from active MoneyRules; consumed exactly once by a payment. Users can never supply fee, tax or total values \u2014 the quote is the only source. Amounts are integers in the quote currency's minor units.",
  "properties": {
    "reference": {
      "type": "string",
      "title": "Reference (RK-QUOTE-\u2026)"
    },
    "contest_id": {
      "type": "string",
      "title": "Contest ID"
    },
    "brand_id": {
      "type": "string",
      "title": "Brand ID (payer)"
    },
    "market": {
      "type": "string",
      "enum": [
        "IN",
        "GLOBAL"
      ],
      "title": "Market"
    },
    "currency": {
      "type": "string",
      "title": "Currency (ISO 4217 \u2014 immutable)"
    },
    "subtotal_minor": {
      "type": "number",
      "title": "Prize Subtotal (minor units)"
    },
    "platform_fee_minor": {
      "type": "number",
      "title": "Platform Fee (minor units)"
    },
    "processing_fee_minor": {
      "type": "number",
      "title": "Processing Fee (minor units)"
    },
    "tax_minor": {
      "type": "number",
      "title": "Tax (minor units)"
    },
    "discount_minor": {
      "type": "number",
      "default": 0,
      "title": "Discount (minor units)"
    },
    "total_minor": {
      "type": "number",
      "title": "Total Payable (minor units)"
    },
    "fee_rule_version": {
      "type": "string",
      "title": "Fee Rule Version"
    },
    "fee_percentage_bps": {
      "type": "number",
      "default": 0,
      "title": "Fee Percentage (bps, snapshot)"
    },
    "tax_rule_version": {
      "type": "string",
      "title": "Tax Rule Version"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CONSUMED",
        "EXPIRED"
      ],
      "default": "ACTIVE",
      "title": "Status"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires At"
    },
    "consumed_by_payment_id": {
      "type": "string",
      "title": "Consumed By Payment ID"
    }
  },
  "required": [
    "reference",
    "contest_id",
    "brand_id",
    "market",
    "currency",
    "subtotal_minor",
    "total_minor",
    "status",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.brand_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}