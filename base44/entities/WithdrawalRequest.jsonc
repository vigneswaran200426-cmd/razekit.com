{
  "name": "WithdrawalRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "amount": {
      "type": "number",
      "title": "Amount",
      "description": "Requested amount \u2014 user-provided at request time. Net payout/commission are server-set during processing."
    },
    "bank_account_last4": {
      "type": "string",
      "title": "Bank Account Last 4"
    },
    "bank_name": {
      "type": "string",
      "title": "Bank Name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending",
      "title": "Status",
      "description": "Server-authoritative. Users may only create a 'pending' request; only a trusted backend/admin/payment-provider flow may advance status."
    },
    "stripe_transfer_id": {
      "type": "string",
      "title": "Stripe Transfer ID"
    },
    "commission": {
      "type": "number",
      "default": 0,
      "title": "Commission",
      "description": "Server-authoritative. NEVER client-writable."
    },
    "fees": {
      "type": "number",
      "default": 0,
      "title": "Fees",
      "description": "Server-authoritative. NEVER client-writable."
    },
    "net_amount": {
      "type": "number",
      "default": 0,
      "title": "Net Amount",
      "description": "Server-authoritative. NEVER client-writable."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "Requested At"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Processed At"
    },
    "rejection_reason": {
      "type": "string",
      "title": "Rejection Reason"
    }
  },
  "required": [
    "user_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}