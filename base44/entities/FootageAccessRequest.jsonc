{
  "name": "FootageAccessRequest",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "title": "Worker ID"
    },
    "worker_name": {
      "type": "string",
      "title": "Worker Name"
    },
    "worker_email": {
      "type": "string",
      "title": "Worker Email"
    },
    "contest_id": {
      "type": "string",
      "title": "Contest ID"
    },
    "contest_title": {
      "type": "string",
      "title": "Contest Title"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending",
      "title": "Status"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "Requested At"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed At"
    },
    "rejection_reason": {
      "type": "string",
      "title": "Rejection Reason"
    },
    "otp_attempts": {
      "type": "number",
      "default": 0,
      "title": "OTP Attempts"
    },
    "otp_locked_until": {
      "type": "string",
      "format": "date-time",
      "title": "OTP Locked Until"
    },
    "otp_verified": {
      "type": "boolean",
      "default": false,
      "title": "OTP Verified"
    }
  },
  "required": [
    "worker_id",
    "contest_id",
    "client_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_role": "editor"
          }
        },
        {
          "user_condition": {
            "user_role": "creator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}