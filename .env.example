# RazeKit frontend environment (Vite). Copy to .env.local for local dev.
# In Vercel, set VITE_API_URL to your deployed backend URL (e.g. https://api.razekit.com).
# NOTE: Vite inlines VITE_* vars into the client bundle — never put secrets here.

# Backend API base URL the frontend calls.
VITE_API_URL=http://localhost:4000
