# RazeKit frontend env (Vite). Copy to .env.local for local dev.
# In production (Render), set VITE_API_URL to the deployed API.
VITE_API_URL=http://localhost:4000

# Development area (autonomous app/website/game builds).
#
# MASTER SWITCH, and it is OFF. Set to exactly "true" and rebuild to turn it on.
# While it is off there is no route, no navigation entry, no page chunk and no
# API surface in the built bundle -- /development is an address that does not
# exist. The API has its own matching switch, DEV_AREA_ENABLED, and BOTH have to
# be on for the area to appear.
VITE_DEV_AREA_ENABLED=false
